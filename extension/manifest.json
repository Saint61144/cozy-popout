{
  "manifest_version": 3,
  "name": "Cozy Popout + Desktop",
  "version": "4.3.2",
  "description": "Keep YouTube close with a floating player and simple playback controls.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "reiner16.png",
    "32": "reiner32.png",
    "48": "reiner48.png",
    "128": "reiner128.png"
  },
  "action": {
    "default_title": "Cozy Popout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "reiner16.png",
      "32": "reiner32.png",
      "48": "reiner48.png",
      "128": "reiner128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "player-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "reiner48.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "key": "",
  "permissions": [
    "nativeMessaging"
  ]
}
